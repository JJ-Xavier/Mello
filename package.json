{
  "name": "mello",
  "productName": "Mello",
  "version": "0.7.1",
  "description": "Planejador pessoal com quadros Kanban e calendário mensal, 100% local.",
  "author": "Jackson Junio",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false && tsc -p tsconfig.test.json --noEmit --composite false",
    "capturas": "electron-vite build && node scripts/capturar-telas.mts",
    "db:generate": "drizzle-kit generate",
    "build:win": "npm run typecheck && electron-vite build && electron-builder --win",
    "postinstall": "node scripts/instalar-electron.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "electron-log": "5.4.4",
    "fractional-indexing": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eslint/js": "10.0.1",
    "@fontsource/inter": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "image-size": "2.0.4",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false,
    "esbuild": false
  }
}
